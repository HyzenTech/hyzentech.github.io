{
  "name": "portfolio-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "astro": "astro",
    "build": "astro build && pagefind --site dist --glob \"{work,writing,notes}/**/*.html\"",
    "check": "astro check",
    "lint": "prettier --check src scripts tests astro.config.mjs package.json",
    "format": "prettier --write src scripts tests astro.config.mjs package.json",
    "test": "node --test tests/*.test.mjs",
    "check:links": "node scripts/check-links.mjs",
    "new:story": "node scripts/new-story.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^5.16.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^5.9.3"
  }
}
