---
interface Action { label: string; href?: string; status?: string; }
interface Props { actions: Action[]; }
const { actions } = Astro.props;
---
<ul class="project-actions" aria-label="Project resources">
  {actions.map(action => <li>{action.href
    ? <a href={action.href}>{action.label} <span aria-hidden="true">↗</span></a>
    : <span class="pending"><strong>{action.label}</strong><small>{action.status}</small></span>
  }</li>)}
</ul>
<style>
  .project-actions{display:flex;flex-wrap:wrap;gap:var(--space-3);list-style:none;padding:0;margin:0;font-family:var(--font-heading)}
  li{margin:0;min-width:0}
  a,.pending{display:flex;flex-direction:column;justify-content:center;border:1px solid var(--color-border);border-radius:var(--border-radius);padding:12px 16px;font-size:var(--text-sm);line-height:1.5}
  a{flex-direction:row;gap:8px;align-items:center;font-weight:600}
  a:hover{background:var(--color-bg-alt)}
  .pending{color:var(--color-text-secondary);background:var(--color-bg-alt)}
  strong{font-weight:500}small{font-size:var(--text-xs);color:var(--color-text-muted)}
</style>
