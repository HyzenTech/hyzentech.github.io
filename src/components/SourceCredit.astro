---
const base = import.meta.env.BASE_URL;
---
<aside class="source-credit" aria-label="Data source attribution">
  <a href="https://github.com/hudl/open-data"><img src={`${base}images/statsbomb-logo.png`} alt="Hudl StatsBomb" width="800" height="122" loading="lazy" /></a>
  <p>Data source: <a href="https://github.com/hudl/open-data">StatsBomb Open Data</a> · Historical WSL 2023/24.<br />Independent, noncommercial research. No provider endorsement.</p>
</aside>
<style>
.source-credit{margin:var(--space-6) 0;padding:var(--space-4);border:1px solid var(--color-border);border-radius:8px}
.source-credit>a{display:block;max-width:240px;background:#fff;padding:10px;border-radius:4px}
.source-credit img{display:block;width:100%;height:auto}
.source-credit p{margin:var(--space-3) 0 0;font-size:var(--text-sm);line-height:1.7;color:var(--color-text-secondary)}
.source-credit p a{text-decoration:underline;text-underline-offset:3px}
</style>
