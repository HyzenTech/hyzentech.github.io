---
import { getEntry, type CollectionEntry } from 'astro:content';
import { dateLabel } from '../lib/content';
interface Props {
  entry: CollectionEntry<'writing'>;
  level?: 2 | 3;
  compact?: boolean;
}
const { entry, level = 3, compact = level === 3 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
const related = entry.data.work
  ? await getEntry('work', entry.data.work)
  : undefined;
---

<article
  class:list={[
    'writing-row',
    'writing-preview',
    { 'writing-preview-compact': compact },
  ]}
  data-filter-item
  data-domains={entry.data.category}
>
  <a
    class="writing-cover"
    href={`/writing/${entry.id}/`}
    tabindex="-1"
    aria-hidden="true"
  >
    <img
      src={entry.data.cover}
      alt=""
      width="380"
      height="480"
      loading="lazy"
    />
  </a>
  <div>
    <p class="eyebrow">
      {entry.data.category} ·{' '}
      <time datetime={entry.data.date.toISOString()}>
        {dateLabel(entry.data.date)}
      </time>
    </p>
    <Heading>
      <a href={`/writing/${entry.id}/`}>{entry.data.title}</a>
    </Heading>
    <p>{entry.data.summary}</p>
    {!compact && (
      <div class="writing-tags">
        {entry.data.tags.slice(0, 3).map((tag) => (
          <span>{tag}</span>
        ))}
        <span>{entry.data.story.estimatedReadTime} min</span>
      </div>
    )}
    {!compact && related && (
      <a class="writing-related-work" href={'/work/' + related.id + '/'}>
        Project: {related.data.title} ↗
      </a>
    )}
  </div>
  <a
    class="row-arrow"
    href={`/writing/${entry.id}/`}
    aria-label={`Read ${entry.data.title}`}
  >
    <span aria-hidden="true">↗</span>
  </a>
</article>
<style>
  .writing-preview {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr) 34px;
    align-items: center;
    gap: 32px;
    padding-block: 28px;
  }
  .writing-cover {
    display: block;
    height: 180px;
    overflow: hidden;
    background: #f5f6f8;
  }
  .writing-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.7s;
  }
  .writing-preview:hover .writing-cover img {
    transform: scale(1.04);
  }
  .writing-preview h2 {
    font-size: 26px;
    line-height: 1.3;
    max-width: 760px;
    margin: 12px 0;
  }
  .writing-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 11px;
    color: var(--muted);
    margin: 16px 0;
  }
  .writing-related-work {
    font-size: 12px;
    color: var(--muted);
  }
  .writing-preview-compact {
    grid-template-columns: 110px minmax(0, 1fr) 34px;
    gap: 24px;
    padding-block: 22px;
  }
  .writing-preview-compact .writing-cover {
    height: 110px;
  }
  @media (max-width: 700px) {
    .writing-preview {
      grid-template-columns: 90px minmax(0, 1fr);
      gap: 20px;
    }
    .writing-cover {
      height: 110px;
    }
    .writing-preview h2 {
      font-size: 20px;
    }
    .writing-preview .row-arrow {
      display: none;
    }
    .writing-preview-compact {
      grid-template-columns: 76px minmax(0, 1fr);
    }
    .writing-preview-compact .writing-cover {
      height: 95px;
    }
    .writing-preview .eyebrow {
      font-size: 10px;
    }
    .writing-preview p {
      font-size: 14px;
    }
    .writing-tags {
      gap: 10px;
    }
    .writing-related-work {
      display: inline-block;
      font-size: 11px;
    }
  }
  @media (max-width: 400px) {
    .writing-preview:not(.writing-preview-compact) {
      grid-template-columns: 1fr;
    }
    .writing-preview:not(.writing-preview-compact) .writing-cover {
      height: 170px;
    }
    .writing-preview-compact {
      grid-template-columns: 1fr;
    }
    .writing-preview-compact .writing-cover {
      height: 130px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .writing-cover img {
      transition: none;
    }
  }
</style>
