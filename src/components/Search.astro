<dialog id="search-dialog" aria-labelledby="search-title">
  <div class="search-heading">
    <h2 id="search-title">Search the portfolio</h2>
    <button type="button" data-search-close aria-label="Close search">
      ✕
    </button>
  </div>
  <label for="search-input" class="sr-only">
    Search Work, Writing, and Notes
  </label>
  <input
    id="search-input"
    type="search"
    placeholder="Projects, ideas, methods…"
    autocomplete="off"
  />
  <p id="search-status" role="status">
    Search Work, Writing, and Notes.
  </p>
  <div id="search-results"></div>
  <p class="search-help">Esc to close · Tab to explore results</p>
</dialog>
