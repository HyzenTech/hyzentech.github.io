<canvas class="ambient-canvas" aria-hidden="true"></canvas>
<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.ambient-canvas');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let width = 0,
      height = 0,
      visible = true,
      frame = 0,
      last = 0;
    function resize() {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      const dpr = Math.min(devicePixelRatio, 1.5);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    function draw(time: number) {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      const light = document.documentElement.dataset.theme === 'light';
      ctx.strokeStyle = light
        ? 'rgba(35,35,42,0.18)'
        : 'rgba(210,210,220,0.28)';
      ctx.lineWidth = 1.3;
      const t = reduced.matches ? 0 : time / 3500;
      const gap = width < 600 ? 30 : 26;
      for (let x = -30; x < width + 30; x += gap) {
        for (let y = -30; y < height + 30; y += gap) {
          const u = x / width,
            v = y / height;
          const wave = Math.sin(u * 9 + v * 4 + t) * Math.cos(v * 7 - t * 0.6);
          const bend = wave * 58;
          const fade = Math.max(0.15, Math.min(1, (u - 0.22) * 1.2 + 0.38));
          ctx.globalAlpha = fade;
          const length = 4 + (wave + 1) * 8;
          for (let k = -2; k <= 2; k++) {
            ctx.beginPath();
            ctx.moveTo(
              x + bend - length / 2,
              y + k * 3 + Math.cos(u * 6 + t) * 9,
            );
            ctx.lineTo(
              x + bend + length / 2,
              y + k * 3 + Math.cos(u * 6 + t) * 9,
            );
            ctx.stroke();
          }
        }
      }
      ctx.globalAlpha = 1;
    }
    function tick(time: number) {
      if (!visible || document.hidden || reduced.matches) {
        frame = 0;
        return;
      }
      if (time - last > 40) {
        draw(time);
        last = time;
      }
      frame = requestAnimationFrame(tick);
    }
    function start() {
      if (!frame && visible && !document.hidden && !reduced.matches)
        frame = requestAnimationFrame(tick);
      else if (reduced.matches) draw(0);
    }
    resize();
    draw(0);
    start();
    new ResizeObserver(() => {
      resize();
      draw(0);
    }).observe(canvas);
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (!visible) {
        cancelAnimationFrame(frame);
        frame = 0;
      } else start();
    }).observe(canvas);
    document.addEventListener('visibilitychange', start);
    document.addEventListener('motionchange', () => {
      cancelAnimationFrame(frame);
      frame = 0;
      draw(0);
      start();
    });
    reduced.addEventListener('change', () => {
      cancelAnimationFrame(frame);
      frame = 0;
      draw(0);
      start();
    });
    new MutationObserver(() => draw(0)).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }
</script>
