---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ambient from '../components/Ambient.astro';
import FeatureSection from '../components/FeatureSection.astro';
import FocusExplorer from '../components/FocusExplorer.astro';
import WritingRow from '../components/WritingRow.astro';
import { getCollection } from 'astro:content';
import { publishedWriting } from '../lib/content';
const work = await getCollection('work');
const recruitment = work.find((e) => e.id === 'football-recruitment-engine')!;
const thermal = work.find((e) => e.id === 'breast-thermal-classification')!;
const writing = await publishedWriting();
const signals = [
  'ML Systems',
  'Applied AI',
  'Research',
  'Football Analytics',
  'Python',
  'Computer Vision',
];
---

<BaseLayout
  title="ML Engineer"
  description="ML Engineer building research-driven systems, intelligent tools, and data products."
>
  <div class="home">
    <section class="hero">
      <Ambient />
      <div class="container hero-inner">
        <div class="hero-copy">
          <h1>
            ML Engineer building research-driven systems, intelligent tools, and
            data products.
          </h1>
          <p class="lead">
            I explore how machine learning, software systems and data can turn
            complex problems into useful products — from AI research to football
            analytics.
          </p>
          <div class="hero-cta">
            <a class="pill-button" href="/work/">
              Explore my work <span aria-hidden="true">→</span>
            </a>
            <a class="pill-button secondary" href="/writing/">
              Read my writing <span aria-hidden="true">↗</span>
            </a>
          </div>
          <button class="hero-search" data-search-open>
            <span>Find a project, idea, or method</span>
            <kbd>⌘ / Ctrl K</kbd>
          </button>
          <p class="focus-line">
            <span>ML Systems</span>
            <span>Applied AI</span>
            <span>Research</span>
            <span>Football Analytics</span>
          </p>
        </div>
      </div>
    </section>
    <div class="signal-strip" aria-label="Areas and tools">
      <div class="signal-track">
        {[...signals, ...signals].map((name, i) => (
          <span aria-hidden={i >= signals.length ? true : undefined}>
            {name}
          </span>
        ))}
      </div>
    </div>
    <div class="container">
      <div class="section-intro" id="selected-work" data-reveal>
        <div>
          <p class="eyebrow">Selected work</p>
          <h2>Questions turned into systems.</h2>
        </div>
        <p>
          Explore the product, then the thinking behind it. Methods, evidence,
          and limits stay together.
        </p>
      </div>
      <FeatureSection
        eyebrow="Flagship · Football analytics"
        title={recruitment.data.title}
        summary="Who looks similar? Who meets the recruitment brief? A reproducible system makes the difference visible, from player profiles to explainable rankings."
        href={'/work/' + recruitment.id + '/'}
        linkLabel="Explore the engine"
        id="recruitment"
      >
        <a
          class="work-preview"
          href={'/work/' + recruitment.id + '/'}
          aria-label="Open the football recruitment case study"
        >
          <img
            src={recruitment.data.cover}
            alt="Actual recruitment interface in its empty query state"
            width="637"
            height="715"
            loading="lazy"
          />
          <span>Player profiles, similarity, and explainable ranking →</span>
        </a>
      </FeatureSection>
      <FeatureSection
        eyebrow="Research · IEEE CENIM 2024"
        title={thermal.data.title}
        summary="A three-class DMR study exploring CNN representations and XGBoost classification for Healthy, Benign, and Malignant thermal images."
        href={'/work/' + thermal.id + '/'}
        linkLabel="Read the research"
        id="research"
      >
        <a
          class="work-preview"
          href={'/work/' + thermal.id + '/'}
          aria-label="Open the thermal research case study"
        >
          <img
            src="/images/blog-cnn-xgboost.webp"
            alt="CNN feature extraction followed by XGBoost classification"
            width="800"
            height="800"
            loading="lazy"
          />
          <span>
            Representations → classification. Read the method and results →
          </span>
        </a>
      </FeatureSection>
    </div>
    <FocusExplorer />
    <section id="writing" class="container">
      <div class="section-intro" data-reveal>
        <div>
          <p class="eyebrow">Visual writing</p>
          <h2>Follow the story.</h2>
        </div>
        <a class="arrow-link" href="/writing/">
          All writing ↗
        </a>
      </div>
      {writing.map((entry) => (
        <WritingRow entry={entry} />
      ))}
    </section>
  </div>
</BaseLayout>
