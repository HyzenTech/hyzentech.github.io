---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceCredit from '../../components/SourceCredit.astro';
import ProjectActions from '../../components/ProjectActions.astro';
const base = import.meta.env.BASE_URL;
const actions = [
  { label: 'Live Demo', status: 'Local preview · publication pending' },
  { label: 'GitHub', status: 'Repository release pending' },
  { label: 'Case Study', href: `${base}blog/football-recruitment-intelligence-engine/` }
];
const experiences = [
  ['01', 'Player Explorer', 'Inspect validated minutes, positional exposure, eligibility and 41 metrics. Values retain units, coverage and peer counts; incomplete observations stay unavailable.'],
  ['02', 'Player Comparison', 'Compare two or three player/team spells with metric tables and positional percentile bars. Different roles keep their own benchmarks.'],
  ['03', 'Similar Players', 'Find within-position event profiles using candidate-only standardized Euclidean distance. Inspect the metrics driving proximity and difference; the index is not a probability or ability score.'],
  ['04', 'Recruitment Search', 'Explore eight fixed scenarios with complete reference populations, weighted contributions and exclusions. The full Python application also supports editable priorities.']
];
---
<BaseLayout
  title="Football Recruitment Intelligence Engine — Hafiz"
  description="A reproducible historical football analytics pipeline: positional player profiles, explained similarity and requirement-based rankings, with frozen V1 evidence and explicit validation limits."
  activeNav="projects"
  canonicalPath={`${base}projects/football-recruitment-intelligence-engine/`}
  socialImage={`${base}images/recruitment-interface-empty.jpg`}
  socialImageAlt="Actual local recruitment interface in an empty-search state, without player statistics"
>
  <article class="recruitment-project container">
    <a class="back-link" href={base}>← All projects</a>
    <header class="project-intro">
      <p class="eyebrow">FOOTBALL ANALYTICS · FROZEN V1</p>
      <h1 class="no-reveal">Football Recruitment Intelligence Engine</h1>
      <p class="lead">From historical event data to a shortlist you can inspect.</p>
      <p class="summary">A reproducible pipeline for positional player profiles, explained similarity and requirement-based rankings. Each result keeps its source, benchmark and evidence gaps visible.</p>
      <ul class="tech" aria-label="Technologies used">
        {['Python 3.12', 'FastAPI', 'Pydantic', 'pytest', 'HTML / CSS / JavaScript'].map(tag => <li>{tag}</li>)}
      </ul>
      <ProjectActions actions={actions} />
      <p class="release-note">Prepared for local review. Public demo data rights and provider registration remain unresolved.</p>
      <SourceCredit />
    </header>

    <figure class="interface-figure">
      <img src={`${base}images/recruitment-interface-empty.jpg`} width="637" height="715" alt="Actual local V1 interface showing Player Explorer with an empty search result; no player statistics are displayed" fetchpriority="high" />
      <figcaption>Actual local V1 application, captured in an empty-search state. Data-backed demo views have been verified locally; their public release remains pending.</figcaption>
    </figure>

    <section aria-labelledby="problem-title" class="project-section problem">
      <div><p class="eyebrow">THE PROBLEM</p><h2 id="problem-title">A score needs a traceable explanation.</h2></div>
      <div><p>Football events can help describe a player’s activity, but a single score hides the conditions behind it: who was compared, how much they played and which observations were missing.</p><p>V1 turns one pinned historical dataset into auditable decision support. It preserves quality flags, validates exposure before per-90 aggregation, and explains similarity and ranking components. It supports an analyst’s inspection; it does not establish transfer suitability.</p></div>
    </section>

    <section aria-labelledby="views-title" class="project-section">
      <p class="eyebrow">THE PRODUCT</p><h2 id="views-title">Four ways to inspect the evidence</h2>
      <div class="experience-grid">{experiences.map(([n,title,copy]) => <div class="experience"><span class="number" aria-hidden="true">{n}</span><h3>{title}</h3><p>{copy}</p></div>)}</div>
      <p class="caption">The static interface presents exported Python results from a frozen verified V1 snapshot. It runs without a Python backend and does not recalculate the analytical model in JavaScript.</p>
    </section>

    <section aria-labelledby="architecture-title" class="project-section">
      <p class="eyebrow">THE ENGINEERING</p><h2 id="architecture-title">A traceable path from source to result</h2>
      <p>Versioned contracts and hashed manifests connect ingestion, quality-gated minutes, missingness-aware features, positional profiles and explained outputs. The local application uses FastAPI; the separate static demo loads verified artifacts on demand.</p>
      <figure class="architecture"><img src={`${base}images/recruitment-architecture.svg`} width="1120" height="740" loading="lazy" alt="Pinned StatsBomb input flows through canonical mapping, quality-gated minutes, features and positional profiles. Profiles feed explained similarity and weighted recruitment. Manifests connect every stage, with replay and sensitivity checks and a local FastAPI interface." /><figcaption>Architecture derived from the frozen V1 source. The static presentation layer is separate from the analytical pipeline.</figcaption></figure>
    </section>

    <section aria-labelledby="evidence-title" class="project-section">
      <p class="eyebrow">WHAT IS VERIFIED</p><h2 id="evidence-title">Engineering evidence, with clear limits</h2>
      <dl class="evidence-grid"><div><dt>220</dt><dd>Original V1 tests passing</dd></div><div><dt>303</dt><dd>Player/team profiles in the frozen cohort</dd></div><div><dt>8</dt><dd>Verified recruitment scenarios</dd></div><div><dt>2</dt><dd>Canonical clean builds with matching receipts</dd></div></dl>
      <p>Stage C adds six export-boundary tests, bringing the local suite to 226 passing tests. Every exported profile, similarity result and ranking scenario was compared against the frozen artifacts. Twenty cohort perturbations test sensitivity, not prediction accuracy.</p>
      <div class="validation-note"><h3>Football validation remains limited</h3><p>CASE-03 is one limited qualitative human review of Kadeisha Buchanan, based on a sampled match with skipped portions and unknown continuous viewing duration. It found agreement around interceptions and tackling activity, while surfacing positioning, risky possession decisions, pressure and score-state context that activity scores cannot adequately capture.</p><p>No recalibration followed. Expert/scout and predictive validation remain pending. General model accuracy and transfer suitability have not been established.</p></div>
    </section>

    <section aria-labelledby="limits-title" class="project-section limits">
      <p class="eyebrow">BOUNDARIES</p><h2 id="limits-title">Historical activity is only part of the picture.</h2>
      <ul><li>One historical Women’s Super League cohort: 2023/24. This is not a current global player database.</li><li>Broad positional groups, with no possession, opponent, score-state or tactical-context adjustment.</li><li>Incomplete components remain unavailable; small complete peer groups suppress comparisons and rankings.</li><li>Goalkeeper analysis covers distribution. Shot-stopping ability is unsupported.</li><li>No age, market-value, contract, injury, salary or current-availability intelligence.</li></ul>
      <p>Source: <a href="https://github.com/hudl/open-data">StatsBomb Open Data</a>, pinned revision <code>4b73468fc5b0f1950f9f66fada70ad3a4f9327cb</code>. Noncommercial historical analysis; provider-data rights are separate from the project’s MIT code license. Exact derived-data publication scope and registration remain unresolved. The official logo is included for source attribution.</p>
    </section>
    <footer class="project-footer"><p>Analytical V1 is frozen. This project page reflects implemented work and verified evidence; future providers, expert validation and a natural-language scouting interface remain deferred.</p><ProjectActions actions={actions} /></footer>
  </article>
</BaseLayout>
<style>
  .recruitment-project{max-width:1120px;padding-top:var(--space-12);padding-bottom:var(--space-20)}
  .back-link{font-family:var(--font-heading);font-size:var(--text-sm);color:var(--color-text-secondary);display:inline-block;margin-bottom:var(--space-10)}
  .eyebrow{font-family:var(--font-heading);font-size:var(--text-xs);letter-spacing:.13em;color:var(--color-text-muted);font-weight:600;margin:0 0 var(--space-4)}
  .project-intro{max-width:900px}.project-intro h1{font-family:var(--font-heading);font-size:clamp(2.2rem,5vw,3.6rem);line-height:1.12;letter-spacing:-.04em;margin:0 0 var(--space-5)}
  .lead{font-size:var(--text-2xl);line-height:1.5;color:var(--color-text-secondary);margin-bottom:var(--space-5)}
  .summary{max-width:760px;color:var(--color-text-secondary)}
  .tech{list-style:none;display:flex;flex-wrap:wrap;gap:var(--space-2);padding:0;margin:var(--space-6) 0}
  .tech li{font-family:var(--font-heading);font-size:var(--text-xs);background:var(--color-bg-alt);border:1px solid var(--color-border);border-radius:var(--border-radius-full);padding:5px 12px;margin:0}
  .release-note,.caption,figcaption{font-family:var(--font-heading);font-size:var(--text-sm);line-height:1.65;color:var(--color-text-muted)}
  .release-note{margin:var(--space-4) 0 0}.interface-figure{margin:var(--space-10) 0 var(--space-16)}
  .interface-figure img{width:100%;max-width:637px;height:auto;border:1px solid var(--color-border);border-radius:var(--border-radius-lg);box-shadow:var(--shadow-sm)}
  figcaption{margin-top:var(--space-3);max-width:850px}.project-section{padding:var(--space-12) 0;border-top:1px solid var(--color-border)}
  h2{font-family:var(--font-heading);font-size:var(--text-3xl);line-height:1.3;margin:0 0 var(--space-6)}
  h3{font-family:var(--font-heading);font-size:var(--text-xl);line-height:1.4;margin:0 0 var(--space-3)}
  .problem{display:grid;grid-template-columns:1fr 1.4fr;gap:var(--space-10)}
  .experience-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-5);margin:var(--space-8) 0}
  .experience{padding:var(--space-6);border:1px solid var(--color-border);border-radius:var(--border-radius-lg);background:var(--color-bg-card)}
  .experience p{font-size:var(--text-base);color:var(--color-text-secondary);margin:0}.number{font-family:var(--font-heading);font-size:var(--text-sm);color:var(--color-text-muted);display:block;margin-bottom:var(--space-4)}
  .architecture{margin:var(--space-8) 0 0}.architecture img{width:100%;background:#f7f8f4;border:1px solid var(--color-border);border-radius:var(--border-radius-lg)}
  .evidence-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-5);margin:var(--space-8) 0}
  dt{font-family:var(--font-heading);font-size:var(--text-4xl);font-weight:600;line-height:1.3}dd{font-family:var(--font-heading);font-size:var(--text-sm);color:var(--color-text-secondary);margin:var(--space-2) 0 0}
  .validation-note{padding:var(--space-6);border-left:3px solid var(--color-accent-sage);background:var(--color-bg-alt);margin-top:var(--space-6)}
  .validation-note p{font-size:var(--text-base);margin-bottom:var(--space-4)}.validation-note p:last-child{margin:0}
  .limits li{margin-bottom:var(--space-3)}.limits a{text-decoration:underline;text-underline-offset:4px}.limits code{font-size:var(--text-sm);overflow-wrap:anywhere}
  .project-footer{border-top:1px solid var(--color-border);padding-top:var(--space-8)}.project-footer p{font-size:var(--text-base);color:var(--color-text-secondary)}
  @media(max-width:768px){.recruitment-project{padding-top:var(--space-8)}.problem,.experience-grid{grid-template-columns:minmax(0,1fr);gap:var(--space-5)}.evidence-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.project-section{padding:var(--space-8) 0}.experience{padding:var(--space-5)}.lead{font-size:var(--text-xl)}.interface-figure{margin-bottom:var(--space-10)}}
</style>
