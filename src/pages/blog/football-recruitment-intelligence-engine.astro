  h1{font-family:var(--font-heading);font-size:clamp(2.1rem,4.5vw,3.4rem);line-height:1.15;letter-spacing:-.035em;max-width:950px;margin:0 0 var(--space-5)}
  .deck{font-size:var(--text-2xl);line-height:1.5;max-width:850px}.review-status{border-left:3px solid var(--color-accent-sage);background:var(--color-bg-alt);padding:var(--space-4);margin:var(--space-6) 0}
