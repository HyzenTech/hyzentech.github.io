  .contents{position:sticky;top:110px;line-height:1.5}.contents strong{color:var(--color-text);font-weight:600}.contents ol{padding-left:18px;margin-top:var(--space-4)}.contents li{margin-bottom:var(--space-3)}.contents a:hover{text-decoration:underline}
  .article-body{min-width:0}.article-body .lead{font-size:var(--text-xl);color:var(--color-text)}
  section{padding-top:var(--space-8);scroll-margin-top:110px}h2{font-family:var(--font-heading);font-size:var(--text-2xl);line-height:1.35;margin-bottom:var(--space-5)}
  p{margin-bottom:var(--space-5)}figure{margin:var(--space-8) 0}figure img{width:100%;height:auto;border:1px solid var(--color-border);border-radius:var(--border-radius)}
  .article-hero figure img{max-width:1000px}.article-hero figure:has(img[src$="recruitment-interface-empty.jpg"]) img{max-width:637px}
  figcaption{line-height:1.6;margin-top:var(--space-3)}.article-body a{text-decoration:underline;text-underline-offset:4px}
  code{font-size:var(--text-sm);overflow-wrap:anywhere;background:var(--color-bg-alt);padding:2px 4px;border-radius:4px}
  .table-wrap:focus-visible{outline:2px solid var(--color-text);outline-offset:4px}.table-wrap{overflow:auto;margin:var(--space-6) 0}table{width:100%;border-collapse:collapse;font-family:var(--font-heading);font-size:var(--text-sm);line-height:1.6}
  caption{text-align:left;font-weight:600;margin-bottom:var(--space-3);color:var(--color-text-secondary)}th,td{padding:12px;text-align:left;border-bottom:1px solid var(--color-border);vertical-align:top}thead th{background:var(--color-bg-alt)}tbody th{font-weight:500}
  .score-bar{display:flex;height:32px;border-radius:6px;overflow:hidden;background:var(--color-bg-alt);margin:var(--space-4) 0}.interceptions{background:#344f3d}.tackles{background:#829575}.long-passes{background:#b8a9c9}
  .legend{list-style:none;display:flex;flex-wrap:wrap;gap:var(--space-3);padding:0;font-family:var(--font-heading);font-size:var(--text-sm);margin:0}.legend li{margin:0}
  .boundary{padding:var(--space-6);background:var(--color-bg-alt);border-left:3px solid var(--color-accent-sage);margin:var(--space-6) 0}.boundary strong{font-family:var(--font-heading)}.boundary p{margin:var(--space-3) 0 0}
  .source-notes{border-top:1px solid var(--color-border);margin-top:var(--space-8);font-size:var(--text-base)}.source-notes li{margin-bottom:var(--space-4)}
  @media(max-width:900px){.reading-layout{grid-template-columns:minmax(0,1fr);gap:var(--space-4);max-width:820px}.contents{position:static;border-bottom:1px solid var(--color-border);padding-bottom:var(--space-4)}.contents ol{columns:2;column-gap:var(--space-6)}.contents li{break-inside:avoid}}
