---
import '../styles/fonts.css';

import '../styles/site.css';
import '../styles/refinement.css';
import Search from '../components/Search.astro';
interface Props {
  title: string;
  description?: string;
  activeNav?: string;
  canonicalPath?: string;
  socialImage?: string;
  socialImageAlt?: string;
  searchable?: boolean;
  contentType?: string;
}
const {
  title,
  description = 'Muhammad Hafiz builds ML systems, applied research and football analytics products.',
  activeNav = '',
  canonicalPath = Astro.url.pathname,
  socialImage,
  socialImageAlt = title,
  searchable = false,
  contentType,
} = Astro.props;
const navigation = [
  ['Work', '/work/'],
  ['Writing', '/writing/'],
  ['About', '/about/'],
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} — Muhammad Hafiz</title>
    <meta name="description" content={description} />
    <meta name="author" content="Muhammad Hafiz" />
    <link rel="canonical" href={new URL(canonicalPath, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(canonicalPath, Astro.site)} />
    {socialImage && (
      <>
        <meta property="og:image" content={new URL(socialImage, Astro.site)} />
        <meta property="og:image:alt" content={socialImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark')
          document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="site-header">
      <div class="nav-wrap">
        <a class="brand" href="/" aria-label="Muhammad Hafiz homepage">
          <span class="brand-mark" aria-hidden="true">
            h.
          </span>
        </a>
        <nav id="main-nav" aria-label="Primary navigation">
          {navigation.map(([label, url]) => (
            <a
              href={url}
              aria-current={
                activeNav === label.toLowerCase() ? 'page' : undefined
              }
            >
              {label}
            </a>
          ))}
          <a class="mobile-extra" href="/resume/">
            Resume
          </a>
          <a class="mobile-extra" href="/notes/">
            Notes
          </a>
        </nav>
        <div class="nav-actions">
          <a class="resume-button" href="/resume/">
            Resume
          </a>
          <a class="social-nav" href="https://github.com/HyzenTech">
            GitHub ↗
          </a>
          <a
            class="social-nav"
            href="https://linkedin.com/in/muhammadhafiz1206"
          >
            LinkedIn ↗
          </a>
          <button
            class="icon-button"
            data-search-open
            aria-label="Search portfolio, Control or Command K"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" />
              <path d="m16 16 5 5" />
            </svg>
          </button>
          <button
            class="theme-button"
            id="theme-button"
            aria-label="Switch to light mode"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="M20 15.2A8 8 0 0 1 8.8 4 8 8 0 1 0 20 15.2Z" />
            </svg>
          </button>
          <button
            class="icon-button menu-button"
            id="menu-button"
            aria-controls="main-nav"
            aria-expanded="false"
            aria-label="Open menu"
          >
            <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main
      id="main-content"
      tabindex="-1"
      data-pagefind-body={searchable || undefined}
    >
      {contentType && (
        <span class="sr-only" data-pagefind-meta="type">
          {contentType}
        </span>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand" href="/">
            HAFIZ
          </a>
          <p>
            Machine learning, software, and data.
            <br />
            From a question to something you can inspect.
          </p>
        </div>
        <div>
          <h2>Explore</h2>
          <a href="/work/">Work</a>
          <a href="/writing/">Writing</a>
          <a href="/notes/">Notes</a>
          <a href="/about/">About</a>
          <a href="/resume/">Resume</a>
        </div>
        <div>
          <h2>Connect</h2>
          <a href="https://github.com/HyzenTech">GitHub ↗</a>
          <a href="https://linkedin.com/in/muhammadhafiz1206">LinkedIn ↗</a>
          <a href="mailto:techhafiz81@gmail.com">Email ↗</a>
          <a href="/contact/">Contact</a>
        </div>
      </div>
      <div class="container footer-bottom">
        © {new Date().getFullYear()} Muhammad Hafiz · Indonesia
      </div>
    </footer>
    <Search />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
